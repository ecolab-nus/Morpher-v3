# 4x4 HyCUBE with memory PEs on x==0 and wrapper placeholders for auto mem layout.

module DP:
    in I1, I2, P
    internal T_INT
    out T
    connect T_INT -> T

module MDP:
    in I1, I2, P
    internal T_INT
    out T
    connect T_INT -> T

module FU:
    in DP0_I1, DP0_I2, DP0_P
    out DP0_T
    sub DP as DP0
    ops latency=1: NOP, ADD, SUB, MUL, SEXT, DIV, LS, RS, ARS, AND, OR, XOR, SELECT, CMERGE, CMP, CLT, BR, CGT, MOVCL, OLOADCL, OLOAD, OLOADH, OLOADB, OSTORE, OSTOREH, OSTOREB, JUMPL, MOVC
    connect DP0_I1 -> DP0.I1
    connect DP0_I2 -> DP0.I2
    connect DP0_P -> DP0.P
    connect DP0.T -> DP0_T

module FU_MEM:
    in DP0_I1, DP0_I2, DP0_P
    out DP0_T
    sub MDP as DP0
    ops latency=2: NOP, ADD, SUB, MUL, SEXT, DIV, LS, RS, ARS, AND, OR, XOR, SELECT, CMERGE, CMP, CLT, BR, CGT, MOVCL, LOADCL, LOAD, LOADH, LOADB, STORE, STOREH, STOREB, OLOADCL, OLOAD, OLOADH, OLOADB, OSTORE, OSTOREH, OSTOREB, JUMPL, MOVC
    connect DP0_I1 -> DP0.I1
    connect DP0_I2 -> DP0.I2
    connect DP0_P -> DP0.P
    connect DP0.T -> DP0_T

module PE_MEM:
    in NORTH_I, WEST_I, EAST_I, SOUTH_I
    out NORTH_O, WEST_O, EAST_O, SOUTH_O
    internal NORTH_XBARI, EAST_XBARI, WEST_XBARI, SOUTH_XBARI
    sub FU_MEM as FU0
    reg NR, ER, WR, SR, TREG
    connect NORTH_I -> NR, NORTH_XBARI
    connect NR -> NORTH_XBARI
    connect EAST_I -> ER, EAST_XBARI
    connect ER -> EAST_XBARI
    connect WEST_I -> WR, WEST_XBARI
    connect WR -> WEST_XBARI
    connect SOUTH_I -> SR, SOUTH_XBARI
    connect SR -> SOUTH_XBARI
    for d in [NORTH, EAST, WEST, SOUTH]:
        connect {d}_XBARI -> FU0.DP0_I1, FU0.DP0_I2, FU0.DP0_P, NORTH_O, WEST_O, EAST_O, SOUTH_O
    connect FU0.DP0_T -> NORTH_O, EAST_O, WEST_O, SOUTH_O, TREG
    connect TREG -> FU0.DP0_I1, FU0.DP0_I2, FU0.DP0_P, NORTH_O, EAST_O, WEST_O, SOUTH_O

module PE:
    in NORTH_I, WEST_I, EAST_I, SOUTH_I
    out NORTH_O, WEST_O, EAST_O, SOUTH_O
    internal NORTH_XBARI, EAST_XBARI, WEST_XBARI, SOUTH_XBARI
    sub FU as FU0
    reg NR, ER, WR, SR, TREG
    connect NORTH_I -> NR, NORTH_XBARI
    connect NR -> NORTH_XBARI
    connect EAST_I -> ER, EAST_XBARI
    connect ER -> EAST_XBARI
    connect WEST_I -> WR, WEST_XBARI
    connect WR -> WEST_XBARI
    connect SOUTH_I -> SR, SOUTH_XBARI
    connect SR -> SOUTH_XBARI
    for d in [NORTH, EAST, WEST, SOUTH]:
        connect {d}_XBARI -> FU0.DP0_I1, FU0.DP0_I2, FU0.DP0_P, NORTH_O, WEST_O, EAST_O, SOUTH_O
    connect FU0.DP0_T -> NORTH_O, EAST_O, WEST_O, SOUTH_O, TREG
    connect TREG -> FU0.DP0_I1, FU0.DP0_I2, FU0.DP0_P, NORTH_O, EAST_O, WEST_O, SOUTH_O

grid 8x8:
    pe PE as PE
    pe PE_MEM as PE_MEM at x==0
    pe PE_MEM as PE_MEM at x==7
    routing mesh4
